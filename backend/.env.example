# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aerocheck
DB_USER=aerocheck_user
DB_PASS=your_secure_password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-required-for-security

# SMTP Configuration (Email Sending)
# Choose one: SendGrid, Mailgun, Gmail, or Mollie
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
SMTP_FROM_EMAIL=noreply@aerocheck.com
SMTP_FROM_NAME=Aerocheck

# Email Settings
EMAIL_VERIFICATION_EXPIRES_HOURS=24
EMAIL_INVITE_EXPIRES_DAYS=7

# Application URL (for email links)
APP_URL=https://aerocheck.com

# Environment
APP_ENV=development
